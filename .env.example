FLASK_ENV=development
FLASK_DEBUG=True

SECRET_KEY=change_this_secret_key_to_a_random_value

# Gemini API configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY_1=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_fallback_gemini_api_key_here
GEMINI_API_KEY_3=your_tertiary_gemini_api_key_here

# App limits
MAX_FILE_SIZE=50MB
RATE_LIMIT=100_per_hour

# Database (Optional)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# Logging
LOG_LEVEL=INFO

